# ---- Dependencies ----
node_modules/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.sublime-*

# ---- Build / TS cache ----
*.tsbuildinfo
.cache/
*.tmp

# ---- Local env / secrets (never commit) ----
.env
.env.local
.env.*.local
*.local

# ---- Keep distribution artifacts tracked (Obsidian install needs them) ----
# main.js, prototype.js, styles.css, manifest.json, package-lock.json are
# intentionally committed — they are the files users copy into .obsidian/plugins/.
